# ------------------------------------------------------------
# Variance inflation factors
#
# Outcome is incidental here; VIFs depend on the predictor
# matrix.
# ------------------------------------------------------------

vif_formula <- stats::as.formula(
  paste(
    "MBI_EE ~",
    paste(
      sewb_vars,
      collapse = " + "
    )
  )
)


vif_model <- stats::lm(
  vif_formula,
  data = dat_final
)


sewb_vif <- car::vif(
  vif_model
)

sewb_vif


# ============================================================
# 5. MAIN RQ1 PATH MODEL
#
# ADHD group + covariates -> SEWB
#
# ADHD group + SEWB + covariates ->
#   emotional exhaustion
#   depersonalization
#   reduced personal accomplishment
#   work engagement
#   perceived stress
#
# MLR estimator + FIML
# ============================================================

rq1_model <- '

# ------------------------------------------------------------
# ADHD group and covariates -> SEWB
# ------------------------------------------------------------

SEWB_E  ~ ADHD_group + age_c + sex_male + sex_diverse
SEWB_QZ ~ ADHD_group + age_c + sex_male + sex_diverse
SEWB_PR ~ ADHD_group + age_c + sex_male + sex_diverse
SEWB_SU ~ ADHD_group + age_c + sex_male + sex_diverse
SEWB_AF ~ ADHD_group + age_c + sex_male + sex_diverse
SEWB_IE ~ ADHD_group + age_c + sex_male + sex_diverse
SEWB_QD ~ ADHD_group + age_c + sex_male + sex_diverse
SEWB_VO ~ ADHD_group + age_c + sex_male + sex_diverse
SEWB_AU ~ ADHD_group + age_c + sex_male + sex_diverse
SEWB_PA ~ ADHD_group + age_c + sex_male + sex_diverse


# ------------------------------------------------------------
# Predictors of burnout, engagement, and perceived stress
# ------------------------------------------------------------

MBI_EE ~
  ADHD_group + age_c + sex_male + sex_diverse +
  SEWB_E + SEWB_QZ + SEWB_PR + SEWB_SU + SEWB_AF +
  SEWB_IE + SEWB_QD + SEWB_VO + SEWB_AU + SEWB_PA

MBI_DP ~
  ADHD_group + age_c + sex_male + sex_diverse +
  SEWB_E + SEWB_QZ + SEWB_PR + SEWB_SU + SEWB_AF +
  SEWB_IE + SEWB_QD + SEWB_VO + SEWB_AU + SEWB_PA

MBI_RPA ~
  ADHD_group + age_c + sex_male + sex_diverse +
  SEWB_E + SEWB_QZ + SEWB_PR + SEWB_SU + SEWB_AF +
  SEWB_IE + SEWB_QD + SEWB_VO + SEWB_AU + SEWB_PA

UWES ~
  ADHD_group + age_c + sex_male + sex_diverse +
  SEWB_E + SEWB_QZ + SEWB_PR + SEWB_SU + SEWB_AF +
  SEWB_IE + SEWB_QD + SEWB_VO + SEWB_AU + SEWB_PA

PSS ~
  ADHD_group + age_c + sex_male + sex_diverse +
  SEWB_E + SEWB_QZ + SEWB_PR + SEWB_SU + SEWB_AF +
  SEWB_IE + SEWB_QD + SEWB_VO + SEWB_AU + SEWB_PA


# ------------------------------------------------------------
# Residual correlations among SEWB dimensions
# ------------------------------------------------------------

SEWB_E  ~~ SEWB_QZ + SEWB_PR + SEWB_SU + SEWB_AF + SEWB_IE +
           SEWB_QD + SEWB_VO + SEWB_AU + SEWB_PA

SEWB_QZ ~~ SEWB_PR + SEWB_SU + SEWB_AF + SEWB_IE +
           SEWB_QD + SEWB_VO + SEWB_AU + SEWB_PA

SEWB_PR ~~ SEWB_SU + SEWB_AF + SEWB_IE +
           SEWB_QD + SEWB_VO + SEWB_AU + SEWB_PA

SEWB_SU ~~ SEWB_AF + SEWB_IE + SEWB_QD +
           SEWB_VO + SEWB_AU + SEWB_PA

SEWB_AF ~~ SEWB_IE + SEWB_QD + SEWB_VO +
           SEWB_AU + SEWB_PA

SEWB_IE ~~ SEWB_QD + SEWB_VO + SEWB_AU + SEWB_PA
SEWB_QD ~~ SEWB_VO + SEWB_AU + SEWB_PA
SEWB_VO ~~ SEWB_AU + SEWB_PA
SEWB_AU ~~ SEWB_PA


# ------------------------------------------------------------
# Residual correlations among outcomes
# ------------------------------------------------------------

MBI_EE  ~~ MBI_DP + MBI_RPA + UWES + PSS
MBI_DP  ~~ MBI_RPA + UWES + PSS
MBI_RPA ~~ UWES + PSS
UWES    ~~ PSS
'


fit_rq1 <- lavaan::sem(
  model = rq1_model,
  data = dat_final,
  estimator = "MLR",
  missing = "fiml",
  fixed.x = FALSE
)


# ============================================================
# 6. R-SQUARED
# ============================================================

rq1_r2 <- lavaan::inspect(
  fit_rq1,
  "r2"
)

rq1_r2


# ============================================================
# 7. ALL REGRESSION PATHS
# ============================================================

rq1_paths <- lavaan::parameterEstimates(
  fit_rq1,
  standardized = TRUE,
  ci = TRUE
) %>%

  dplyr::filter(
    op == "~"
  ) %>%

  dplyr::transmute(
    Outcome = lhs,
    Predictor = rhs,
    b = est,
    SE = se,
    z = z,
    p = pvalue,
    CI_low = ci.lower,
    CI_high = ci.upper,
    beta = std.all
  )


rq1_paths


# ============================================================
# 8. TABLE 2 DATA
# ADHD GROUP + SEWB -> FIVE OUTCOMES
# ============================================================

main_predictors <- c(
  "ADHD_group",
  sewb_vars
)


predictor_labels <- c(
  ADHD_group =
    "ADHD group membership",
  sewb_labels
)


rq1_table <- rq1_paths %>%

  dplyr::filter(
    Outcome %in% outcome_vars,
    Predictor %in% main_predictors
  ) %>%

  dplyr::mutate(

    Predictor_label =
      unname(
        predictor_labels[
          Predictor
        ]
      ),

    Outcome_label =
      unname(
        outcome_labels[
          Outcome
        ]
      )
  ) %>%

  dplyr::select(
    Outcome,
    Outcome_label,
    Predictor,
    Predictor_label,
    b,
    SE,
    z,
    p,
    CI_low,
    CI_high,
    beta
  )


rq1_table
