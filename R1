# ============================================================
# 3. ADHD GROUP DIFFERENCES IN SEWB
# ============================================================

# ------------------------------------------------------------
# Cohen's d
#
# Positive d = higher scores in ADHD group
# ------------------------------------------------------------

cohen_d <- function(x, group) {

  keep <- complete.cases(x, group)

  x <- x[keep]
  group <- group[keep]

  x0 <- x[group == 0]
  x1 <- x[group == 1]

  pooled_sd <- sqrt(
    (
      (length(x0) - 1) * stats::var(x0) +
      (length(x1) - 1) * stats::var(x1)
    ) /
      (
        length(x0) +
        length(x1) -
        2
      )
  )

  (
    mean(x1) -
      mean(x0)
  ) / pooled_sd
}


# ------------------------------------------------------------
# Welch independent-samples t tests
# ------------------------------------------------------------

sewb_group_results <- purrr::map_dfr(
  sewb_vars,
  function(v) {

    x <- dat_final[[v]]
    g <- dat_final$ADHD_group

    test <- stats::t.test(
      x ~ g
    )

    tibble::tibble(
      Variable = v,
      Dimension = unname(sewb_labels[v]),

      M_comparison =
        mean(x[g == 0], na.rm = TRUE),

      SD_comparison =
        stats::sd(x[g == 0], na.rm = TRUE),

      M_ADHD =
        mean(x[g == 1], na.rm = TRUE),

      SD_ADHD =
        stats::sd(x[g == 1], na.rm = TRUE),

      t =
        unname(test$statistic),

      df =
        unname(test$parameter),

      p =
        test$p.value,

      Cohen_d =
        cohen_d(x, g)
    )
  }
) %>%

  dplyr::mutate(
    p_Holm =
      stats::p.adjust(
        p,
        method = "holm"
      )
  )


sewb_group_results


